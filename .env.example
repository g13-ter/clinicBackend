# Copy this file to .env and fill in real values.
# Never commit the actual .env file - it's already in .gitignore.

# MongoDB connection string (e.g. from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGO_URI=

# Secret used to sign JWT auth tokens.
# Use a long, random string - do NOT reuse this value across environments
# (local, staging, production should each have their own).
JWT_SECRET=

# How long a login token stays valid before the user has to log in again.
# Optional - defaults to "1d" if not set. Examples: "1h", "7d", "30m"
JWT_EXPIRE=1d

# Allowed frontend origin(s) for CORS. Set to your deployed frontend URL in production.
# Accepts a single URL or a comma-separated list (no spaces needed around commas)
# if you need more than one, e.g. your production domain plus Vercel preview URLs.
# Example: https://clinic.yourdomain.com
# Example (multiple): https://clinic.yourdomain.com,https://clinic-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Port the server listens on locally.
# Optional - defaults to 5000 if not set.
# Note: on Railway (and most hosts), this is injected automatically
# and does not need to be set manually.
PORT=5000

# Set automatically to "production" by most hosting platforms (e.g. Railway).
# Leave unset for local development - the app behaves correctly either way.
# NODE_ENV=production

# Used only by tests/seedAdmin.ts (one-time script to create the first
# admin account). Optional - defaults to admin@clinic.com / admin123
# if not set, which is fine for local dev only. Before running this
# script against a real/production database, set real values here
# so the default credentials are never used outside local testing.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Resend API key for sending emails (appointment confirmations/reminders,
# low-stock alerts, purchase-request notifications). Optional - if unset,
# emails are simply skipped (logged instead of sent) and everything else
# in the app keeps working normally. Get a key at https://resend.com
RESEND_API_KEY=

# "From" address used for all outgoing emails. Must be a verified sender/
# domain in your Resend account, or Resend will reject sends. Optional -
# falls back to Resend's shared onboarding address if unset (fine for
# testing, not for real production use).
EMAIL_FROM=School Clinic <clinic@yourdomain.com>

# Shared secret required to call POST /api/internal/send-reminders, which
# triggers the 24h-before appointment reminder sweep. Only needed if you
# want an EXTERNAL scheduler (Railway Cron, GitHub Actions, etc.) to
# trigger the sweep - the app also runs this sweep on its own every hour
# via an in-process job as long as the server keeps running. Optional -
# if unset, the internal route is disabled (returns 503) but the
# in-process hourly sweep still runs. Use a long random string.
INTERNAL_API_KEY=